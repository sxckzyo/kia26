<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexusBlogs</title>
    <link rel="icon" href="imagens/quefotopeaknoway.png">
    <style> 
        body{
            background-color: rgb(21, 21, 22);
            color: rgb(255, 255, 255);
            margin: 0;
            transition: background-color 0.3s, color 0.3s;

        }

        body.whitemode{  /* o tema padrão é o escuro, que ta ali em cima */
            background-color: rgb(255, 255, 255);
            color: rgb(0, 0, 0); /* é preto se não o texto some no fundo branco */
            transition: background-color 0.3s, color 0.3s;

        }

        header{
              background-color: #151516;
              color: #c9c9c9;
              text-align: center;
              max-width: 800px;
              margin: 0 auto;
              padding: 16px;
              border: 5px solid #353436;
        }

      main {
        background-color: #151516;
        color: #b4b4b4 !important; /* esse ai é importante e vai primeiro kkkkkk*/
        max-width: 800px;
        margin: 0 auto;
        padding: 16px;
    }

      body.whitemode main{
        background-color: #ffffff;
        color: #000000;
        transition: background-color 0.3s, color 0.3s;
      }
      
      body.whitemode header{
        background-color: #ffffff;
        color: #000000;
      }

      article{
    display: flex;
    gap: 15px;
    align-items: flex-start
    }

    body.whitemode article h2,
    body.whitemode article p,
    body.whitemode article span{
        color: #131212
    }


      img {
    width: 150px;
    height: 150px;
    object-fit: cover;
    }

      img.grande{
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 13px;
    }

    .artigo-autor {
    font-weight: bold;
    }

    #troca-tema{
        position: fixed;
        top: 20px; /* distancia do topo*/
        right: 20px;
        z-index: 1000; /* fica sobre qualquer coisa*/

        /* em cima disso é importante, abaixo é só pra deixar bonito msmkkkkk*/

        padding: 10px, 20px;
        border: none;
        border-radius: 7px;
        cursor: pointer;

        /*cor do botão e coisas assim*/

        background-color: transparent;
        border: 2px solid #ffffff; /* a ordem é border: [espessura] [estilo] [cor]*/
        color: #ffffff;
    }
    
    body.whitemode #troca-tema{
        border-color: #000000; 
        color: #000000;
    }

    </style>
</head>
<body>
    <header>

        <p><h1>NexusBlogs</h1>
    <p>Descrição do blog</p>
    </header>
    <main>
        <article>
            <img src="imagens/abacaxi.png" alt="Ícone de um abacaxi fresco com fatias e um pouco de suco em detalhes fotorrealistas meramente ilustrativas.">
             <div>
    
                 <h2>Post1</h2>
                 <p class="artigo-autor">Por: Rafael</p>
                 <p>Corpo do Post1</p>
                     <button>❤️<span>0</span></button>
                     <button>👍<span>0</span></button>
             </div>
        </article>
        <article>
            <img src="imagens/billie eilish redhair.png" alt="Foto da cantora Billie Eilish e seu cabelo com mechas pintadas de vermelho." class="grande">
            <div>
   
                <h2>Post2</h2>
                <p class="artigo-autor">Por: Rafael</p>
                <p>Corpo do Post2.</p>
                    <button>❤️<span>0</span></button>
                    <button>👍<span>0</span></button>
           </div>
        </article>
        </main>

        <button id="troca-tema">🎨</button> 

        <script>
            const botaotema = document.getElementById("troca-tema");

            if (botaotema) {
            botaotema.addEventListener("click", () => {
                    // Adiciona / remove a classe do body
            document.body.classList.toggle("whitemode");
            console.log("WhiteMode Escolhido?", document.body.classList.contains("whitemode"));
             });
            }   
        </script>

    <script>
    const botoes = document.querySelectorAll("button");

    botoes.forEach(function(botao) {
        // Ignora o botão de tema para não contar like nele
        if (botao.id === "troca-tema") return; 

        let curtiu = false;
    botao.addEventListener("click", botaoClicado);
    function botaoClicado() {
        console.log("fui clicado");
        let texto = botao.querySelector("span");
        if (curtiu ==    false){
            texto.textContent++;
            curtiu = true;
        } else{
             texto.textContent--;
             curtiu = false;
        }
    }
});


</script>
</body>
</html>   
